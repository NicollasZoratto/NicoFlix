# Copie este arquivo para ".env" (que fica fora do Git) e ajuste os valores.
# O docker-compose.yml lê essas variáveis automaticamente.

# --- Banco de dados (MariaDB / MySQL remoto) ---
DB_HOST=35.226.64.52
DB_USER=IAC_2026_02_nicollas_carvalho
DB_PASSWORD=nico11as
DB_NAME=IAC_2026_02_nicollas_carvalho

# --- Segredos da aplicação ---
JWT_SECRET=chave_secreta_jwt_super_segura
SECRET_KEY=chave_secreta_padrao_desenv

# --- TMDB ---
TMDB_API_KEY=6566259ba55415e75fcdaaec316a8be7

# --- URL pública do catálogo (usada no link de "esqueci minha senha") ---
PUBLIC_APP_URL=http://localhost:8223

# --- SMTP / Mailtrap (obrigatório para o e-mail de redefinição de senha
# realmente ser enviado; sem isso, o link só aparece no log do container) ---
# 1. Crie uma conta gratuita em https://mailtrap.io
# 2. Vá em Email Testing > Inboxes > (sua inbox) > SMTP Settings
# 3. Copie host/porta/usuário/senha da opção "Flask" ou "Python"
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=seu_usuario_mailtrap
SMTP_PASS=sua_senha_mailtrap
SMTP_FROM=no-reply@nicoflix.local

# --- MinIO (Atividade 6: fotos de perfil) ---
MINIO_ROOT_USER=nicoflix_admin
MINIO_ROOT_PASSWORD=troque_esta_senha_em_producao
MINIO_BUCKET=nicoflix-perfis
# Host:porta que o NAVEGADOR do usuário vai usar pra baixar a foto (URL
# pré-assinada). Em dev local, localhost:9000. Em produção/Portainer,
# use o IP público ou domínio do servidor + :9000 (ex: 35.xxx.xxx.xxx:9000).
PUBLIC_MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
PRESIGNED_URL_EXPIRY_SECONDS=3600
